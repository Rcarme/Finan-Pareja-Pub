# =====================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env)
# Copiá este archivo a .env y ajustá los valores según tu instalación.
# =====================================================================

# Entorno: development, test, production
ENVIRONMENT=production

# Clave secreta para cookies de sesión firmadas y tokens CSRF
# Generar una clave segura ejecutando: openssl rand -hex 32
APP_SECRET_KEY=

# Token de autorización previo para inicializar la instancia en /setup (Opcional pero recomendado).
# Si se define, nadie podrá configurar la instancia sin ingresar este valor.
# SETUP_TOKEN=un-token-secreto-aleatorio-de-instalacion

# ---------------------------------------------------------------------
# Base de Datos PostgreSQL
# ---------------------------------------------------------------------
# Si usás Docker Compose, el host es 'db'. Si corrés en local, es 'localhost'.
POSTGRES_DB=finanzas
POSTGRES_ADMIN_USER=finanzas_bootstrap
POSTGRES_ADMIN_PASSWORD=definir-password-admin-segura
POSTGRES_OWNER_PASSWORD=definir-password-owner-segura
POSTGRES_APP_PASSWORD=definir-password-app-segura

# URL de conexión para la aplicación web
DATABASE_URL=postgresql://finanzas_app:definir-password-app-segura@db:5432/finanzas

# URL para el servicio de backup (misma base, mismo usuario de app)
BACKUP_DATABASE_URL=postgresql://finanzas_app:definir-password-app-segura@db:5432/finanzas

# URL para migraciones DDL con Alembic (rol owner)
MIGRATION_DATABASE_URL=postgresql://finanzas_owner:definir-password-owner-segura@db:5432/finanzas

# ---------------------------------------------------------------------
# Servidor Web y Red
# ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
APP_HOST_PORT=8088
APP_BIND_ADDRESS=127.0.0.1
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Lista de IPs o CIDRs de proxies inversos de confianza (Nginx, Caddy, Cloudflare, Traefik).
# Uvicorn sólo aceptará cabeceras X-Forwarded-* de estas IPs. Por defecto: 127.0.0.1.
FORWARDED_ALLOW_IPS=127.0.0.1

# Moneda principal por defecto del hogar (código ISO 4217 de 3 letras: ARS, USD, EUR, MXN, CLP, etc.)
# También se puede definir durante el asistente inicial (/setup).
DEFAULT_CURRENCY=ARS

# Habilitar actualización periódica de cotizaciones cambiarias (true/false)
FX_AUTOMATIC_ENABLED=true

# ---------------------------------------------------------------------
# Asistente Inteligente (Google Gemini AI) - OPCIONAL
# ---------------------------------------------------------------------
# Podés definirla acá o ingresarla directamente en la pantalla de bienvenida / login / ajustes.
# Obtené una clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# Backups Cifrados con age y GFS (Grandfather-Father-Son) - OPCIONAL
# ---------------------------------------------------------------------
# Clave pública de age para cifrar los backups en reposo.
# Generar par de claves: age-keygen -o key.txt (guardar la privada fuera del servidor)
AGE_PUBLIC_KEY=
RCLONE_REMOTE=gdrive:finanzas_backups
BACKUP_TASK_TIMEOUT_SECONDS=7200
BACKUP_VERIFY_RETRY_SECONDS=3600
